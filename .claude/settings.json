{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/check-before-push.mjs\" --claude-hook",
            "timeout": 60,
            "onFailure": "block",
            "statusMessage": "GitHubに上げる前の確認"
          }
        ]
      }
    ]
  }
}
